-    return [...weakDue, ...learnedDue];
+    const seen = new Set();
+    return [...weakDue, ...learnedDue].filter(word => {
+        const key = getWordKeySafe(word, word.__sourceLevel || gameState.currentLevel);
+        if (seen.has(key)) return false;
+        seen.add(key);
+        return true;
+    });
+}
+
+function getReviewLaneWordsPool(limit = 12) {
+    const now = Date.now();
+    const pool = [
+        ...getReviewWordsByModeAcrossLevels('weak'),
+        ...getReviewWordsByModeAcrossLevels('learned')
+    ];
+
+    const seen = new Set();
+    return pool
+        .map(word => {
+            const key = getWordKeySafe(word, word.__sourceLevel || gameState.currentLevel);
+            if (seen.has(key)) return null;
+            seen.add(key);
+            const s = ensureSrsEntry(key);
+            return {
+                word,
+                key,
+                dueAt: s.dueAt || now,
+                state: gameState.wordStates[key] || 'unlearned'
+            };
+        })
+        .filter(Boolean)
+        .sort((a, b) => {
+            const aDue = a.dueAt <= now ? 0 : 1;
+            const bDue = b.dueAt <= now ? 0 : 1;
+            if (aDue !== bDue) return aDue - bDue;
+            if (a.state !== b.state) {
+                if (a.state === 'weak') return -1;
+                if (b.state === 'weak') return 1;
+            }
+            return a.dueAt - b.dueAt;
+        })
+        .slice(0, limit);
+}
+
+function formatReviewEnemyEta(dueAt) {
+    const diff = Number(dueAt || 0) - Date.now();
+    if (diff <= 0) return 'NOW';
+    const min = Math.ceil(diff / 60000);
+    if (min < 60) return `${min}m`;
+    const hours = Math.ceil(min / 60);
+    if (hours < 24) return `${hours}h`;
+    return `${Math.ceil(hours / 24)}d`;
+}
+
+function updateTowerDefenseHUD(dueWords = null, laneWords = null) {
+    const isActive = gameState.reviewMode === 'on';
+    if (document.body) {
+        document.body.classList.toggle('td-mode-active', isActive);
+    }
+
+    const hud = document.getElementById('tdModeHud');
+    if (!hud) return;
+
+    hud.style.display = isActive ? 'grid' : 'none';
+    if (!isActive) return;
+
+    const duePool = Array.isArray(dueWords) ? dueWords : getDueReviewWordsPool();
+    const lanePool = Array.isArray(laneWords) ? laneWords : getReviewLaneWordsPool(12);
+    const now = Date.now();
+    const dueNow = duePool.length;
+    const approaching = lanePool.filter(entry => entry.dueAt > now).length;
+    const soon = lanePool.filter(entry => entry.dueAt > now && (entry.dueAt - now) <= 60 * 60 * 1000).length;
+    const towerHp = Math.max(20, Math.min(100, 100 - (dueNow * 8) - (soon * 3)));
+
+    const hpEl = document.getElementById('tdTowerHp');
+    const approachingEl = document.getElementById('tdApproachingCount');
+    if (hpEl) hpEl.textContent = String(towerHp);
+    if (approachingEl) approachingEl.textContent = String(approaching);
+    hud.dataset.pressure = dueNow > 0 ? 'danger' : (soon > 0 ? 'soon' : 'calm');
 }
 
