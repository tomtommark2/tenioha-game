{
  "scripts": {
    "sync:html": "node scripts/sync-html.js",
    "check:html-sync": "node scripts/check-html-sync.js",
    "check:version-sync": "node scripts/check-version-sync.js",
    "generate:review-word-hashes": "node scripts/generate-review-word-hashes.js",
    "check:review-word-hashes": "node scripts/generate-review-word-hashes.js --check",
    "release:version": "node scripts/bump-version.js && npm run sync:html && npm run check:html-sync && npm run check:version-sync",
    "release:patch": "npm run release:version",
    "test:unit": "node node_modules/playwright/cli.js test --config playwright.unit.config.js",
    "test:functions": "node --test functions/review-score-policy.test.js",
    "test:e2e": "node node_modules/playwright/cli.js test",
    "test:e2e:ui": "node node_modules/playwright/cli.js test --ui",
    "test:e2e:headed": "node node_modules/playwright/cli.js test --headed",
    "test:mobile-modals": "node node_modules/playwright/cli.js test --config playwright.mobile.config.js",
    "test:e2e:safe": "npm run sync:html && npm run check:html-sync && npm run check:version-sync && npm run check:review-word-hashes && npm run test:unit && npm run test:functions && node node_modules/playwright/cli.js test"
  },
  "dependencies": {
    "firebase-tools": "^15.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
