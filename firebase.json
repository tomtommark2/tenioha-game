{
  "functions": [
    {
      "source": "functions",
      "predeploy": ["node scripts/security-config.cjs --check"],
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "**/*.test.js",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "predeploy": ["node scripts/security-config.cjs --check"],
    "rules": "firestore.rules"
  }
}
