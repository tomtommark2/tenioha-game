rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Seed and verify this private document BEFORE deploying these rules.
    // Missing or malformed configuration fails closed, never unblocks everyone.
    function isBanned() {
      let path = /databases/$(database)/documents/security_private/blocklist;
      let config = exists(path) ? get(path).data : {};
      return !(config.keys().hasAll(['schemaVersion', 'blockedUids', 'blockedEmails'])
               && config.schemaVersion == 1
               && config.blockedUids is list && config.blockedEmails is list)
             || request.auth.uid in config.blockedUids
             || ('email' in request.auth.token && request.auth.token.email in config.blockedEmails);
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isRegistered() {
      return isSignedIn()
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function protectedUserFields() {
      return [
        'isPremium',
        'premiumExpiresAt',
        'premiumSource',
        'premiumSince',
        'premiumMatchReason',
        'lastActivatedAt',
        'stripeCustomerId',
        'stripeCustomerIdTest',
        'stripeCustomerIdLive',
        'stripeEnvironment',
        'stripePaymentId',
        'stripeCheckoutSessionId',
        'stripePaymentLinkId',
        'stripePaymentStatus',
        'usedCode',
        'redeemedCodes'
      ];
    }

    // --- Collection Rules ---

    match /security_private/{document=**} {
      allow read, write: if false;
    }

    // 1. Users Collection
    // Clients can manage learning data, but only Admin SDK code may change billing state.
    match /users/{userId} {
      allow read: if isRegistered() && isOwner(userId) && !isBanned();
      allow create: if isRegistered()
                    && isOwner(userId)
                    && !isBanned()
                    && !request.resource.data.keys().hasAny(protectedUserFields());
      allow update: if isRegistered()
                    && isOwner(userId)
                    && !isBanned()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields());
      allow delete: if false;
      
      // Require at least one subcollection segment so this cannot also match
      // the parent /users/{userId} document under rules_version = '2'.
      match /{collectionId}/{document=**} {
        allow read, write: if isRegistered() && isOwner(userId) && !isBanned();
      }
    }

    // 2. Legacy gold leaderboard: retained for reference, no longer writable.
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Review score data is server-authoritative. Clients use Cloud Functions only.
    match /review_score_events/{document=**} {
      allow read, write: if false;
    }

    match /review_score_daily/{document=**} {
      allow read, write: if false;
    }

    match /review_score_weekly/{document=**} {
      allow read, write: if false;
    }

    // 3. Promo Codes Collection
    // Feedback is accessed through the API; author IDs and reports are private.
    match /feedback_posts/{document=**} { allow read, write: if false; }
    match /feedback_limits/{document=**} { allow read, write: if false; }
    match /feedback_reports/{document=**} { allow read, write: if false; }

    // Promo codes are validated and redeemed only by redeemTeniohaPromoCode.
    match /promocodes/{code} {
      allow read, write: if false;
    }

    // 4. Config Collection
    // Public Read-only (for version checks)
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
