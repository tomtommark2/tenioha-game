rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 🚫 BAN LIST CONFIGURATION 🚫 ---
    // Blocked User IDs (Cheaters)
    // Add the specific UID to this list to strictly block all writes
    function isBanned() {
      // Blocked User IDs (Cheaters) & Emails
      return request.auth.uid in ['Z6gybt3F4Fcq0XrQs64AAHWdxCL2'] ||
             request.auth.token.email in [
                 'shanbenkensuke@gmail.com',
                 'shanbenhassaku839@gmail.com'
             ];
    }
    // ------------------------------------

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function protectedUserFields() {
      return [
        'isPremium',
        'premiumExpiresAt',
        'premiumSource',
        'premiumSince',
        'premiumMatchReason',
        'lastActivatedAt',
        'stripeCustomerId',
        'stripeCustomerIdTest',
        'stripeCustomerIdLive',
        'stripeEnvironment',
        'stripePaymentId',
        'stripeCheckoutSessionId',
        'stripePaymentLinkId',
        'stripePaymentStatus',
        'usedCode',
        'redeemedCodes'
      ];
    }

    // --- Collection Rules ---

    // 1. Users Collection
    // Clients can manage learning data, but only Admin SDK code may change billing state.
    match /users/{userId} {
      allow read: if isOwner(userId) && !isBanned();
      allow create: if isOwner(userId)
                    && !isBanned()
                    && !request.resource.data.keys().hasAny(protectedUserFields());
      allow update: if isOwner(userId)
                    && !isBanned()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields());
      allow delete: if false;
      
      match /daily_logs/{logId} {
        allow read, write: if isOwner(userId) && !isBanned();
      }
      
      // Require at least one subcollection segment so this cannot also match
      // the parent /users/{userId} document under rules_version = '2'.
      match /{collectionId}/{document=**} {
        allow read, write: if isOwner(userId) && !isBanned();
      }
    }

    // 2. Leaderboard Collection
    // Public read, Owner write
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) && !isBanned();
    }

    // 3. Promo Codes Collection
    // Promo codes are validated and redeemed only by redeemTeniohaPromoCode.
    match /promocodes/{code} {
      allow read, write: if false;
    }

    // 4. Config Collection
    // Public Read-only (for version checks)
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
